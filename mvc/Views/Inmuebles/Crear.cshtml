@model Inmobiliaria_.Net_Core.Models.Inmueble

@{
    ViewData["Title"] = "Alta de Inmueble";
    var propietarios = ViewBag.Propietarios as IList<Inmobiliaria_.Net_Core.Models.Propietario> ?? new List<Inmobiliaria_.Net_Core.Models.Propietario>();
    var tiposInmueble = ViewBag.tipoInmueble as IList<Inmobiliaria_.Net_Core.Models.tipoInmueble> ?? new List<Inmobiliaria_.Net_Core.Models.tipoInmueble>();
}

<h2>Alta de Inmueble</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="Crear" method="post">
    @Html.AntiForgeryToken()

    <div class="form-group mb-2">
        <label asp-for="Direccion" class="control-label"></label>
        <input asp-for="Direccion" class="form-control" />
        <span asp-validation-for="Direccion" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="IdTipoInmueble" class="control-label">Tipo de Inmueble</label>
        <select asp-for="IdTipoInmueble" class="form-control" required>
            <option value="">-- Seleccione un tipo --</option>
            @foreach (var tipo in tiposInmueble)
            {
                <option value="@tipo.idTipoInmueble">@tipo.Descripcion</option>
            }
        </select>
        <span asp-validation-for="IdTipoInmueble" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="PropietarioId" class="control-label">Propietario</label>
        <select asp-for="PropietarioId" class="form-control" required>
            <option value="">-- Seleccione un propietario --</option>
            @foreach (var prop in propietarios)
            {
                <option value="@prop.IdPropietario">@prop.Nombre @prop.Apellido (DNI: @prop.Dni)</option>
            }
        </select>
        <span asp-validation-for="PropietarioId" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Cupo" class="control-label"></label>
        <input asp-for="Cupo" class="form-control" type="number" min="1" required />
        <span asp-validation-for="Cupo" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="PrecioPorDia" class="control-label"></label>
        <input asp-for="PrecioPorDia" class="form-control" type="number" step="0.01" min="0" required />
        <span asp-validation-for="PrecioPorDia" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="PorcentajeReserva" class="control-label"></label>
        <input asp-for="PorcentajeReserva" class="form-control" type="number" step="0.01" min="0" max="100" required />
        <span asp-validation-for="PorcentajeReserva" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Latitud" class="control-label"></label>
        <input asp-for="Latitud" class="form-control" type="number" step="any" required />
        <span asp-validation-for="Latitud" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Longitud" class="control-label"></label>
        <input asp-for="Longitud" class="form-control" type="number" step="any" required />
        <span asp-validation-for="Longitud" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-success">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</form>