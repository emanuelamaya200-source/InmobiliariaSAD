@using Inmobiliaria_.Net_Core.Models
@model Inmobiliaria_.Net_Core.Models.Inmueble

@{
    ViewData["Title"] = Model.Id == 0 ? "Alta de Inmueble" : "Modificar Inmueble";
    IList<Propietario>? propietarios = (IList<Propietario>?)ViewBag.Propietarios ?? new List<Propietario>();
    IList<tipoInmueble>? tiposInmuebles = (IList<tipoInmueble>?)ViewBag.tipoInmueble ?? new List<tipoInmueble>();
}

<h2>@(Model.Id == 0 ? "Alta de Inmueble" : "Modificar Inmueble")</h2>
<hr />

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="Guardar" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Campo Id oculto -->
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-2">
                <label asp-for="Direccion" class="control-label"></label>
                <input asp-for="Direccion" class="form-control" required />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Tipo Inmueble</label>
                <select class="form-select" asp-for="IdTipoInmueble" required>
                    <option value="">-- Seleccione el Tipo de Inmueble --</option>
                    @foreach (tipoInmueble t in tiposInmuebles)
                    {
                        <option value="@t.idTipoInmueble" selected="@(t.idTipoInmueble == Model.IdTipoInmueble)">
                            @t.Descripcion
                        </option>
                    }
                </select>
                <span asp-validation-for="PropietarioId" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Cupo" class="control-label"></label>
                <input asp-for="Cupo" class="form-control" type="number" min="1" required />
                <span asp-validation-for="Cupo" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="PrecioPorDia" class="control-label">Precio por Día</label>
                <input asp-for="PrecioPorDia" class="form-control" type="number" step="0.01" required />
                <span asp-validation-for="PrecioPorDia" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="PorcentajeReserva" class="control-label">% Reserva</label>
                <input asp-for="PorcentajeReserva" class="form-control" type="number" step="0.01" required />
                <span asp-validation-for="PorcentajeReserva" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Latitud" class="control-label"></label>
                <input asp-for="Latitud" class="form-control" type="number" step="any" />
                <span asp-validation-for="Latitud" class="text-danger"></span>
            </div>

            <div class="form-group mb-2"> <label asp-for="Longitud" class="control-label"></label> <input
                asp-for="Longitud" class="form-control" type="number" step="any" /> <span
                asp-validation-for="Longitud" class="text-danger"></span> </div>

                <div class="form-group mb-3">
                    <label class="control-label">Propietario (DNI)</label>

                    <div class="input-group">
                        <input list="listaDnis" class="form-control" id="dniPropietario" placeholder="Escriba el DNI..."
                               autocomplete="off" />

                        <button type="button" class="btn btn-primary" onclick="confirmarPropietario()">
                            Confirmar
                        </button>
                    </div>
                    <datalist id="listaDnis">
                        @foreach (var p in propietarios)
                        {
                            <option value="@p.Dni">
                                @p.Nombre @p.Apellido
                            </option>
                        }
                    </datalist>

                    <div id="propietarioEncontrado" class="mt-2"></div>

                    <input type="hidden" asp-for="PropietarioId" id="PropietarioId" />

                    <span asp-validation-for="PropietarioId" class="text-danger"></span>
                </div>
            

                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </form>
        </div>
    </div>
    <script>
        function confirmarPropietario() {

            const dni = document.getElementById("dniPropietario").value.trim();

            const propietarios = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(propietarios)
                            );

            const propietario = propietarios.find(p =>
                p.Dni.toString() === dni
            );

            const resultado = document.getElementById("propietarioEncontrado");
            const id = document.getElementById("PropietarioId");

            if (propietario) {

                id.value = propietario.IdPropietario;

                resultado.innerHTML = `
                    <div class="alert alert-success">
                        ✓ <strong>Propietario confirmado</strong><br>
                        ${propietario.Nombre} ${propietario.Apellido}<br>
                        DNI: ${propietario.Dni}
                    </div>
                `;

            } else {

                id.value = "";

                resultado.innerHTML = `
                    <div class="alert alert-danger">
                        ✕ <strong>DNI no encontrado</strong><br>
                        Verifique el número ingresado.
                    </div>
                `;
            }
        }
    </script>