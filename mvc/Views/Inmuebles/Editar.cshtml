@using Inmobiliaria_.Net_Core.Models
@model Inmobiliaria_.Net_Core.Models.Inmueble

@{
    ViewData["Title"] = Model.Id == 0 ? "Alta de Inmueble" : "Modificar Inmueble";
    Propietario? propietarioSeleccionado = ViewBag.PropietarioSeleccionado as Propietario;
    IList<tipoInmueble>? tiposInmuebles = (IList<tipoInmueble>?)ViewBag.tipoInmueble ?? new List<tipoInmueble>();
}

<h2>@(Model.Id == 0 ? "Alta de Inmueble" : "Modificar Inmueble")</h2>
<hr />

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="Editar" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Campo Id oculto -->
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-2">
                <label asp-for="Direccion" class="control-label"></label>
                <input asp-for="Direccion" class="form-control" required />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Tipo Inmueble</label>
                <select class="form-select" asp-for="IdTipoInmueble" required>
                    <option value="">-- Seleccione el Tipo de Inmueble --</option>
                    @foreach (tipoInmueble t in tiposInmuebles)
                    {
                        <option value="@t.idTipoInmueble" selected="@(t.idTipoInmueble == Model.IdTipoInmueble)">
                            @t.Descripcion
                        </option>
                    }
                </select>
                <span asp-validation-for="PropietarioId" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Cupo" class="control-label"></label>
                <input asp-for="Cupo" class="form-control" type="number" min="1" required />
                <span asp-validation-for="Cupo" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="PrecioPorDia" class="control-label">Precio por Día</label>
                <input asp-for="PrecioPorDia" class="form-control" type="number" step="0.01" required />
                <span asp-validation-for="PrecioPorDia" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="PorcentajeReserva" class="control-label">% Reserva</label>
                <input asp-for="PorcentajeReserva" class="form-control" type="number" step="0.01" required />
                <span asp-validation-for="PorcentajeReserva" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Latitud" class="control-label"></label>
                <input asp-for="Latitud" class="form-control" type="number" step="any" />
                <span asp-validation-for="Latitud" class="text-danger"></span>
            </div>

            <div class="form-group mb-2"> <label asp-for="Longitud" class="control-label"></label> <input
                asp-for="Longitud" class="form-control" type="number" step="any" /> <span
                asp-validation-for="Longitud" class="text-danger"></span> </div>

               <div class="form-group mb-4">
                <label asp-for="PropietarioId" class="control-label">Propietario</label>
                <select asp-for="PropietarioId" class="form-control select2-propietarios" required>
                    <option value="">-- Busque DNI o Nombre --</option>
                    @if (propietarioSeleccionado != null)
                    {
                        <option value="@propietarioSeleccionado.IdPropietario" selected>
                            @propietarioSeleccionado.Dni - @propietarioSeleccionado.Nombre @propietarioSeleccionado.Apellido
                        </option>
                    }
                </select>
                <span asp-validation-for="PropietarioId" class="text-danger"></span>
            </div>
            
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </form>
        </div>
    </div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            $('.select2-propietarios').select2({
                placeholder: "Busque por DNI o Nombre",
                allowClear: true,
                width: '100%',
                ajax: {
                    url: '@Url.Action("BuscarPropietarios", "Inmuebles")',
                    dataType: 'json',
                    data: params => ({ term: params.term }),
                    processResults: data => data
                }
            });
        });
    </script>
}