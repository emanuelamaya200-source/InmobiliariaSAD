@model IEnumerable<Inmobiliaria_.Net_Core.Models.Inmueble>

<h2>Listado de Inmuebles</h2>

<p>
    <a asp-action="Crear" class="btn btn-primary">Alta Inmueble</a>
</p>

<div class="col-md-6">
    <form asp-action="Index" method="get" class="d-flex">
        <input type="text" name="nombre" class="form-control me-2" placeholder="Buscar por Tipo o Dirección..." value="@ViewBag.Nombre" />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        @if (!string.IsNullOrEmpty(ViewBag.Nombre))
        {
            <a asp-action="Index" class="btn btn-outline-danger ms-2" title="Limpiar búsqueda">Limpiar</a>
        }
    </form>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Dirección</th>
            <th>Tipo de Inmueble</th>
            <th>Cupo</th>
            <th>Precio por Día</th>
            <th>Porcentaje de Reserva</th>
            <th>Latitud</th>
            <th>Longitud</th>
            <th>PropietarioId</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Id</td>
            <td>@item.Direccion</td>
            <td>@item.Tipo.Descripcion</td>
            <td>@item.Cupo</td>
            <td>@item.PrecioPorDia</td>
            <td>@item.PorcentajeReserva</td>
            <td>@item.Latitud</td>
            <td>@item.Longitud</td>
            <td>@item.Duenio</td>
            <td>
                <a asp-action="Detalles" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Detalles">
                    <i class="bi bi-info-circle"> </i> Detalles
                </a>
                @if (User.IsInRole("Administrador"))
					{
                <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                    <i class="bi bi-pencil-square"> </i> Modificar
                </a>
                <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                    <i class="bi bi-trash-fill"> </i> Borrar
                </a>
                }
            </td>
        </tr>

}
    </tbody>
</table>
<ul class="pagination">
    @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
    {
        <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-nombre="@ViewBag.Nombre">@i</a>
        </li>
    }
</ul>