@model IEnumerable<Inmobiliaria_.Net_Core.Models.Inmueble>

<h2>Listado de Inmuebles</h2>

<p>
    <a asp-action="Crear" class="btn btn-primary">Alta Inmueble</a>
    <a asp-action="InformeReservas" class="btn btn-outline-primary">Más reservados (365 días)</a>
    <a asp-action="InformeReservas" asp-route-sinReservas="true" class="btn btn-outline-secondary">Sin reservas recientes</a>
</p>

<div class="row mb-3">
    <div class="col-md-8">
        <form asp-action="Index" method="get" class="d-flex align-items-end gap-2">
            <div class="flex-grow-1">
                <input type="text" name="nombre" class="form-control" placeholder="Buscar por Tipo o Dirección..." value="@ViewBag.Nombre" />
            </div>
            <div>
                <select name="disponibilidad" class="form-select">
                    <option value="">Todos</option>
                    <option value="1" selected="@(ViewBag.Disponibilidad != null && (int)ViewBag.Disponibilidad == 1 ? "selected" : null)">Disponibles</option>
                    <option value="0" selected="@(ViewBag.Disponibilidad != null && (int)ViewBag.Disponibilidad == 0 ? "selected" : null)">No Disponibles</option>
                </select>
            </div>
            <button type="submit" class="btn btn-outline-secondary">Buscar</button>
            @if (!string.IsNullOrEmpty(ViewBag.Nombre as string) || ViewBag.Disponibilidad != null)
            {
                <a asp-action="Index" class="btn btn-outline-danger" title="Limpiar búsqueda">Limpiar</a>
            }
        </form>
    </div>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Dirección</th>
            <th>Tipo de Inmueble</th>
            <th>Cupo</th>
            <th>Precio por Día</th>
            <th>Porcentaje de Reserva</th>
            <th>Latitud</th>
            <th>Longitud</th>
            <th>PropietarioId</th>
            <th>Disponible</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Id</td>
            <td>@item.Direccion</td>
            <td>@item.Tipo?.Descripcion</td>
            <td>@item.Cupo</td>
            <td>@item.PrecioPorDia</td>
            <td>@item.PorcentajeReserva</td>
            <td>@item.Latitud</td>
            <td>@item.Longitud</td>
            <td>@item.Duenio</td>
            <td>
                @if (item.Habilitado) {
                    <span class="badge bg-success">Sí</span>
                } else {
                    <span class="badge bg-secondary">No</span>
                }
            </td>
            <td>
                <a asp-action="Detalles" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Detalles">
                    <i class="bi bi-info-circle"> </i> Detalles
                </a>
                @if (User.IsInRole("Administrador"))
				{
                <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                    <i class="bi bi-pencil-square"> </i> Modificar
                </a>
                <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                    <i class="bi bi-trash-fill"> </i> Borrar
                </a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
<ul class="pagination">
    @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
    {
        <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
            <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-nombre="@ViewBag.Nombre" asp-route-disponibilidad="@ViewBag.Disponibilidad">@i</a>
        </li>
    }
</ul>