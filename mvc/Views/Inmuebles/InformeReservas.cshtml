@model IEnumerable<Inmobiliaria_.Net_Core.Models.Inmueble>

<h2>@(ViewBag.SinReservas ? $"Inmuebles sin reservas en los últimos {ViewBag.Dias} días" : "Inmuebles más reservados en los últimos 365 días")</h2>

@if (ViewBag.SinReservas)
{
    <form method="get" class="row g-2 mb-3">
        <input type="hidden" name="sinReservas" value="true" />
        <div class="col-auto">
            <label for="plazo" class="form-label">Período</label>
            <select id="plazo" name="plazo" class="form-select">
                <option value="30" selected="@(ViewBag.Plazo == 30)">30 días</option>
                <option value="60" selected="@(ViewBag.Plazo == 60)">60 días</option>
                <option value="90" selected="@(ViewBag.Plazo == 90)">90 días</option>
                <option value="360" selected="@(ViewBag.Plazo == 360)">360 días</option>
                <option value="0" selected="@(ViewBag.Plazo == 0)">Personalizado</option>
            </select>
        </div>
        <div class="col-auto">
            <label for="diasPersonalizados" class="form-label">Días personalizados</label>
            <input id="diasPersonalizados" type="number" name="diasPersonalizados" value="@ViewBag.DiasPersonalizados" min="1" max="3650" class="form-control" />
        </div>
        <div class="col-auto align-self-end">
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </form>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Inmueble</th>
            <th>Dirección</th>
            @if (!ViewBag.SinReservas)
            {
                <th>Reservas</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var inmueble in Model)
            {
                <tr>
                    <td>@inmueble.Id</td>
                    <td>@inmueble.Direccion</td>
                    @if (!ViewBag.SinReservas)
                    {
                        <td>@inmueble.CantidadReservas</td>
                    }
                </tr>
            }
        }
        else
        {
            <tr><td colspan="3" class="text-center">No hay resultados para este informe.</td></tr>
        }
    </tbody>
</table>

<ul class="pagination">
    @for (int pagina = 1; pagina <= ViewBag.TotalPaginas; pagina++)
    {
        <li class="page-item @(pagina == ViewBag.PaginaActual ? "active" : "")">
            <a class="page-link" asp-action="InformeReservas" asp-route-sinReservas="@ViewBag.SinReservas" asp-route-plazo="@ViewBag.Plazo" asp-route-diasPersonalizados="@ViewBag.DiasPersonalizados" asp-route-pagina="@pagina">@pagina</a>
        </li>
    }
</ul>

<a asp-action="Index" class="btn btn-outline-secondary">Volver a inmuebles</a>