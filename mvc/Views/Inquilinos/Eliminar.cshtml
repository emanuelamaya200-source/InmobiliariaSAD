@model Inmobiliaria_.Net_Core.Models.Inquilino

<h2>Confirmar Eliminación</h2>
<p class="text-danger">¿Estás seguro de que deseas eliminar este inquilino?</p>

<div>
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre @Model.Apellido</dd>
        <dt class="col-sm-2">DNI</dt>
        <dd class="col-sm-10">@Model.Dni</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
    </dl>

    <form asp-action="Borrar" method="post">
        <input type="hidden" name="id" value="@Model.IdInquilino" />
        <button type="submit" class="btn btn-danger">Borrar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>