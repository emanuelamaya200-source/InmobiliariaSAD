@model Inmobiliaria_.Net_Core.Models.Pago

<h2>Confirmar Baja</h2>
<p class="text-danger">¿Estás seguro de que deseas dar de baja este pago?</p>

<div>
    <dl class="row">
        <dt class="col-sm-2">estado</dt>
        <dd class="col-sm-10">@Model.Estado</dd>
    </dl>

    <form asp-action="Borrar" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.IdPago" />
        <button type="submit" class="btn btn-danger">Baja</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>