@model Inmobiliaria_.Net_Core.Models.Pago

<h2>Anular pago</h2>
<p class="text-danger">El pago permanecerá en el historial y figurará como anulado. ¿Continuar?</p>

<div>
    <dl class="row">
        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Model.Estado</dd>
    </dl>

    <form asp-action="Borrar" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.IdPago" />
        <button type="submit" class="btn btn-danger">Anular pago</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>