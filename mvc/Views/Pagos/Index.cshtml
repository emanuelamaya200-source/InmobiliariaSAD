@model IEnumerable<Inmobiliaria_.Net_Core.Models.Pago>

<h2>Listado de Pagos</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>IdReserva</th>
            <th>Concepto</th>
            <th>Monto</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (Inmobiliaria_.Net_Core.Models.Pago item in Model) {
        <tr>
            <td>@item.IdPago</td>
            <td>@item.IdReserva</td>
            <td>@item.Concepto</td>
            <td>@item.Monto</td>
            <td>@item.Fecha</td>
            <td>@item.Estado</td>
            <td>
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Editar" asp-route-id="@item.IdPago" class="btn btn-sm btn-warning" title="Modificar Concepto">
                        <i class="bi bi-pencil-square"> </i> Modificar
                    </a>
                    @if (item.Estado == "Inactivo")
                    {
                        <form asp-action="Alta" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.IdPago" />
                            <button type="submit" class="btn btn-sm btn-success" title="Dar Alta">
                                <i class="bi bi-check-circle-fill"></i> Alta
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-action="Eliminar" asp-route-id="@item.IdPago" class="btn btn-sm btn-danger" title="Dar Baja">
                            <i class="bi bi-trash-fill"></i> Baja
                        </a>
                    }
                }
            </td>
        </tr>
}
    </tbody>
</table>
<ul class="pagination">
    @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
    {
        <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
            <a class="page-link" asp-route-pagina="@i">@i</a>
        </li>
    }
</ul>