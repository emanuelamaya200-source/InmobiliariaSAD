@model Inmobiliaria_.Net_Core.Models.Usuario

<h2>Mi Perfil</h2>

<div class="card p-4 col-md-6 shadow-sm mt-3">
    <dl class="row mb-3">
        <dt class="col-sm-4 text-muted">Nombre:</dt>
        <dd class="col-sm-8">@Model.Nombre</dd>

        <dt class="col-sm-4 text-muted">Apellido:</dt>
        <dd class="col-sm-8">@Model.Apellido</dd>

        <dt class="col-sm-4 text-muted">Email:</dt>
        <dd class="col-sm-8">@Model.Email</dd>

        <dt class="col-sm-4 text-muted">Rol:</dt>
        <dd class="col-sm-8">@Model.RolNombre</dd> 
    </dl>

    <div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver al Inicio
        </a>
    </div>
</div>