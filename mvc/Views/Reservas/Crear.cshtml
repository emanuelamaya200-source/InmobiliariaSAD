@using Inmobiliaria_.Net_Core.Models
@model Inmobiliaria_.Net_Core.Models.Reserva

@{
    ViewData["Title"] = "Alta de Reserva";
    IList<Inquilino>? inquilinos = (IList<Inquilino>?)ViewBag.Inquilinos ?? new List<Inquilino>();
    IList<Inmueble>? inmuebles = (IList<Inmueble>?)ViewBag.Inmuebles ?? new List<Inmueble>();    
}

<h2>Alta de Reserva</h2>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-action="Crear" method="post">
    @Html.AntiForgeryToken()

    <div class="form-group mb-3">
        <label class="control-label">Seleccione el Inmueble</label>
        <select class="form-select" asp-for="IdInmueble" required>
            <option value="">-- Seleccione un Inmueble --</option>
            @foreach (Inmueble t in inmuebles)
            {
                <option value="@t.Id">
                    (@t.Id) , @t.Direccion , @t.Tipo.Descripcion
                </option>
            }
        </select>
        <span asp-validation-for="IdInmueble" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="control-label">Inquilino</label>
        <select class="form-select" asp-for="IdInquilino" required>
            <option value="">-- Seleccione un Inquilino --</option>
            @foreach (Inquilino p in inquilinos)
            {
                <option value="@p.IdInquilino">
                    (@p.Nombre @p.Apellido) (DNI: @p.Dni)
                </option>
            }
        </select>
        <span asp-validation-for="IdInquilino" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="FechaDeEntrada" class="control-label">Fecha De Entrada</label>
        <input asp-for="FechaDeEntrada" class="form-control" type="date" required />
        <span asp-validation-for="FechaDeEntrada" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="FechaDeSalida" class="control-label">Fecha De Salida</label>
        <input asp-for="FechaDeSalida" class="form-control" type="date" required />
        <span asp-validation-for="FechaDeSalida" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>