@using Inmobiliaria_.Net_Core.Models
@model Inmobiliaria_.Net_Core.Models.Reserva

@{
    ViewData["Title"] = "Modificar Reserva";
    Inquilino? inquilinoSeleccionado = ViewBag.InquilinoSeleccionado as Inquilino;
    Inmueble? inmuebleSeleccionado = ViewBag.InmuebleSeleccionado as Inmueble;
}

<h2>Modificar Reserva</h2>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-action="Guardar" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdReserva" />

    <div class="form-group mb-3">
        <label class="control-label">Seleccione el Inmueble</label>
        <select class="form-select" asp-for="IdInmueble" id="selectInmueble" required>
            <option value=""></option>
            @if (inmuebleSeleccionado != null)
            {
                <option value="@inmuebleSeleccionado.Id" selected
                        data-precio="@inmuebleSeleccionado.PrecioPorDia"
                        data-porcentaje="@inmuebleSeleccionado.PorcentajeReserva">
                    (@inmuebleSeleccionado.Id) @inmuebleSeleccionado.Direccion - @inmuebleSeleccionado.Tipo?.Descripcion
                </option>
            }
        </select>
        <span asp-validation-for="IdInmueble" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="control-label">Inquilino</label>
        <select class="form-select" asp-for="IdInquilino" id="selectInquilino" required>
            <option value=""></option>
            @if (inquilinoSeleccionado != null)
            {
                <option value="@inquilinoSeleccionado.IdInquilino" selected>
                    @inquilinoSeleccionado.Nombre @inquilinoSeleccionado.Apellido (DNI: @inquilinoSeleccionado.Dni)
                </option>
            }
        </select>
        <span asp-validation-for="IdInquilino" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="FechaDeEntrada" class="control-label">Fecha De Entrada</label>
        <input asp-for="FechaDeEntrada" class="form-control" type="date" required />
        <span asp-validation-for="FechaDeEntrada" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="FechaDeSalida" class="control-label">Fecha De Salida</label>
        <input asp-for="FechaDeSalida" class="form-control" type="date" required />
        <span asp-validation-for="FechaDeSalida" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Guardar Cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $('#selectInmueble, #selectInquilino').each(function () {
            const url = this.id === 'selectInmueble'
                ? '@Url.Action("BuscarInmuebles", "Reservas")'
                : '@Url.Action("BuscarInquilinos", "Reservas")';

            $(this).select2({
                placeholder: 'Escriba para buscar',
                allowClear: true,
                width: '100%',
                ajax: {
                    url: url,
                    dataType: 'json',
                    data: params => ({ term: params.term }),
                    processResults: data => data
                }
            });
        });
    </script>
}