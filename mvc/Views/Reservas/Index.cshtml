@model IEnumerable<Inmobiliaria_.Net_Core.Models.Reserva>

@{
    ViewData["Title"] = "Listado de Reservas";
    
}

<h2>Listado de Reservas</h2>

<p>
    <a asp-action="Crear" class="btn btn-primary">Alta Reserva</a>
</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input type="date" name="inicio" value="@ViewBag.Inicio" class="form-control" /></div>
    <div class="col-md-3"><input type="date" name="fin" value="@ViewBag.Fin" class="form-control" /></div>
    <div class="col-md-2"><input type="number" name="cupo" value="@ViewBag.Cupo" min="1" placeholder="Cupo mínimo"
                                     class="form-control" /></div>
        <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Buscar disponibilidad</button></div>
        <div class="col-auto"><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
    </form>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.IdReserva)</th>
                <th>@Html.DisplayNameFor(model => model.IdInmueble)</th>
                <th>@Html.DisplayNameFor(model => model.IdInquilino)</th>
                <th>@Html.DisplayNameFor(model => model.MontoTotal)</th>
                <th>@Html.DisplayNameFor(model => model.PagoRealizado)</th>
                <th>Fecha de Entrada</th>
                <th>Fecha de Salida</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdReserva</td>
                        <td>@item.NombreInmueble</td>
                        <td>@item.NombreInquilino</td>
                        <td>@item.MontoTotal</td>
                        <td>@item.PagoRealizado</td>
                        <td>@item.FechaDeEntrada.ToString("dd/MM/yyyy")</td>
                        <td>@item.FechaDeSalida.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-action="Detalles" asp-route-id="@item.IdReserva" class="btn btn-sm btn-info" title="Detalles">
                                <i class="bi bi-info-circle"> </i> Detalles
                            </a>
                            <a asp-controller="Pagos" asp-action="Crear" asp-route-idReserva="@item.IdReserva"
                               class="btn btn-sm btn-success" title="Pagar">
                                <i class="bi bi-credit-card"></i> Pagar
                            </a>
                            @if (item.Estado == "Activo")
                            {
                                <a asp-action="Finalizar" asp-route-id="@item.IdReserva" class="btn btn-sm btn-danger">
                                    <i class="bi bi-calendar-x"></i> Finalizar
                                </a>
                            }
                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-action="Renovar" asp-route-id="@item.IdReserva"
                                   class="btn btn-sm btn-outline-success">Renovar</a>
                                <a asp-action="Editar" asp-route-id="@item.IdReserva" class="btn btn-sm btn-warning" title="Modificar">
                                    <i class="bi bi-pencil-square"> </i> Modificar
                                </a>
                                <a asp-action="Eliminar" asp-route-id="@item.IdReserva" class="btn btn-sm btn-danger" title="Borrar">
                                    <i class="bi bi-trash-fill"> </i> Borrar
                                </a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">No hay reservas registradas.</td>
                </tr>
            }
        </tbody>
    </table>
    <ul class="pagination">
        @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
        {
            <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                <a class="page-link" asp-route-pagina="@i" asp-route-inicio="@ViewBag.Inicio" asp-route-fin="@ViewBag.Fin"
                   asp-route-cupo="@ViewBag.Cupo">@i</a>
            </li>
        }
    </ul>