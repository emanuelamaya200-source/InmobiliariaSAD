@model Inmobiliaria_.Net_Core.Models.tipoInmueble

@{
    ViewData["Title"] = "Alta de Tipo de Inmueble";
}

<h2>Alta de Tipo de Inmueble</h2>

<form asp-action="Crear" method="post">
    @Html.AntiForgeryToken()

    <div class="form-group mb-2">
        <label asp-for="Descripcion" class="control-label">Descripción</label>
        <input asp-for="Descripcion" class="form-control" required />
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-success">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</form>