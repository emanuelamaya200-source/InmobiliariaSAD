@model Inmobiliaria_.Net_Core.Models.tipoInmueble

<h2>Detalle de Tipo de Inmueble</h2>

<div class="card p-3 col-md-6 shadow-sm mt-3">
    <dl class="row mb-3">
        <dt class="col-sm-4 text-muted">Código:</dt>
        <dd class="col-sm-8 fw-bold">#@Model.idTipoInmueble</dd>

        <dt class="col-sm-4 text-muted">Descripción:</dt>
        <dd class="col-sm-8">@Model.Descripcion</dd>
    </dl>

    <div>
        <a asp-action="Editar" asp-route-id="@Model.idTipoInmueble" class="btn btn-warning">
            <i class="bi bi-pencil-square"></i> Modificar
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver al listado
        </a>
    </div>
</div>