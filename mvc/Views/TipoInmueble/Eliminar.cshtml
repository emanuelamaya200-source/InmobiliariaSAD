@model Inmobiliaria_.Net_Core.Models.tipoInmueble

<h2>Confirmar Eliminación</h2>
<p class="text-danger">¿Estás seguro de que deseas eliminar este tipo?</p>

<div>
    <dl class="row">
        <dt class="col-sm-2">Descripcion</dt>
        <dd class="col-sm-10">@Model.Descripcion</dd>
    </dl>

    <form asp-action="Borrar" method="post">
        <input type="hidden" name="id" value="@Model.idTipoInmueble" />
        <button type="submit" class="btn btn-danger">Borrar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>